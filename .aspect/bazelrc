common:aspect-common --heap_dump_on_oom
common:aspect-common --experimental_repository_cache_hardlinks

common:aspect-cache --remote_upload_local_results
common:aspect-cache --remote_accept_cached
common:aspect-cache --remote_timeout=3600
common:aspect-cache --remote_retries=360
common:aspect-cache --grpc_keepalive_timeout=30s

common:aspect-bes --grpc_keepalive_timeout=30s
common:aspect-bes --generate_json_trace_profile
common:aspect-bes --noslim_profile
common:aspect-bes --experimental_profile_include_target_label
common:aspect-bes --experimental_profile_include_primary_output
common:aspect-bes --legacy_important_outputs
common:aspect-bes --remote_build_event_upload=all

# %workspace%-relative, and Bazel will not create the parent directory.
common:aspect-execlog --execution_log_compact_file=%workspace%/.aspect/generated/exec.log.zstd

# The two halves are named separately because they are enabled by different
# things: CI puts the cache in every job's ~/.bazelrc, while .aspect/config.axl
# adds BES to `aspect <task>` alone, so vanilla `bazel` never reports a build.
common:aspect-cloud-cache --config=aspect-common
common:aspect-cloud-cache --config=aspect-cache
common:aspect-cloud-cache --remote_cache=grpcs://cache.aspect.build
common:aspect-cloud-cache --credential_helper=cache.aspect.build=aspect

common:aspect-cloud-bes --config=aspect-bes
common:aspect-cloud-bes --bes_backend=grpcs://bes.aspect.build
common:aspect-cloud-bes --bes_results_url=https://app.aspect.build/i/
common:aspect-cloud-bes --credential_helper=bes.aspect.build=aspect

common:aspect-cloud --config=aspect-cloud-cache
common:aspect-cloud --config=aspect-cloud-bes
