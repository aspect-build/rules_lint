"""Aspect Cloud wiring, shared by every workspace in this repo.

Each examples/* tree is its own Bazel workspace with its own .aspect/config.axl,
so the logic lives here once and each config.axl loads it by relative path.
"""

load("@aspect//feature/workflows.axl", "get_build_metadata_flags")
load("@aspect//traits.axl", "BazelTrait")

def report_to_aspect_cloud(ctx, exec_log = False):
    """Send this build's results to Aspect Cloud, when CI has a token for them.

    The cache half is in the ~/.bazelrc CI writes, which vanilla `bazel` reads
    too. This is the half that must not reach it — only `aspect <task>` runs
    config.axl — so `bazel build` stays a cache client and reports nothing.

    Fork PRs get no secret and so get neither half: an unauthenticated
    credential helper is fatal to the build.

    `exec_log` is the root workspace only: the log's path is %workspace%-relative
    and Bazel will not create the parent, which only the root commits.
    """
    if not ctx.std.env.var("CI"):
        return
    if ctx.std.env.var("ASPECT_HAS_API_TOKEN") != "true":
        return

    flags = ctx.traits[BazelTrait].extra_flags
    flags.append("--config=aspect-cloud-bes")
    if exec_log:
        flags.append("--config=aspect-execlog")

    # The CLI only emits --build_metadata on an Aspect Workflows runner, so on
    # GitHub-hosted runners we ask for it. Re-exported through the feature
    # module here; it moves to the public @aspect//bazel/build_metadata.axl in
    # 2026.38.10, so this load is what an upgrade past that has to revisit.
    flags.extend(get_build_metadata_flags(ctx.std))
