# Repo-owned, unlike %workspace%/.aspect/bazelrc which `aspect setup bazelrc`
# regenerates. Imported by the ~/.bazelrc CI writes.
#
# Aspect Cloud's cache without its BES: build results come from the aspect-cli
# jobs, which get cache, BES, auth and metadata from `--remote` instead. Named
# groups come from the generated file, so the tuning stays in step with it.
common:aspect-cloud-cache --config=aspect-common
common:aspect-cloud-cache --config=aspect-cache
common:aspect-cloud-cache --remote_cache=grpcs://cache.aspect.build
common:aspect-cloud-cache --credential_helper=cache.aspect.build=aspect
