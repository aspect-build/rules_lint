# Aspect's rc for vanilla `bazel`. Generated at the repository root by
# `aspect setup bazelrc`; regenerate there, not here. %workspace% is this
# example, so `../..` reaches the root the examples share.
try-import %workspace%/../../.aspect/bazelrc

import %workspace%/../java/tools/java21.bazelrc

common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

build:lint --aspects=//tools/lint:linters.bzl%scalafix

# Build without the bytes
common:ci --remote_download_outputs=minimal
common:ci --nobuild_runfile_links

# Override the preset's `--lockfile_mode=error` on CI since we don't
# yet commit MODULE.bazel.lock — see .gitignore.
common:ci --lockfile_mode=off
