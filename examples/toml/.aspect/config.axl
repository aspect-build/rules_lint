"""Aspect CLI configuration."""

def config(ctx: ConfigContext):
    # Register the linter aspect so `aspect lint -- //...` runs it
    # natively (no Bazel `--config=lint`).
    ctx.tasks["lint"].args.aspects = [
        "//tools/lint:linters.bzl%taplo",
    ]
    ctx.tasks["lint"].args.rules_lint_fix_flag = "@rules_lint//lint:fix"
